#!/usr/bin/env bash
set -euo pipefail

current_branch="$(git rev-parse --abbrev-ref HEAD)"
protected_regex='^(main|master|develop|dev)$'

git fetch --all --prune >/dev/null

# Delete branches already merged into the current branch, except protected names.
git branch --merged | sed 's/^..//' | while IFS= read -r branch; do
  [[ -z "$branch" ]] && continue
  [[ "$branch" == "$current_branch" ]] && continue
  if [[ "$branch" =~ $protected_regex ]]; then
    continue
  fi
  echo "Deleting merged branch: $branch"
  git branch -d "$branch"
done
