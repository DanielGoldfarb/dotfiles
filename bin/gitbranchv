#!/usr/bin/env bash
git branch --format=' %(color:bold blue)%(HEAD)%(color:reset) %(align:18,18)%(refname:short)%(end) %(color:yellow)%(objectname:short)%(color:reset) %(color:green)%(committerdate:format:%Y-%m-%d %H:%M)%(color:reset)  %(contents:subject) %(color:bold blue)<%(authorname)>%(color:reset)' "${@}"
