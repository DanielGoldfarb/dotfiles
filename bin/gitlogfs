#!/usr/bin/env python

import subprocess as sp
import sys

ColorDict = dict( Black       = '0;30' ,  DarkGray   = '1;30' ,
                  Red         = '0;31' ,  LightRed   = '1;31' ,
                  Green       = '0;32' ,  LightGreen = '1;32' ,
                  Gold        = '0;33' ,  Yellow     = '1;33' ,
                  Blue        = '0;34' ,  LightBlue  = '1;34' ,
                  Purple      = '0;35' ,  LightPurple= '1;35' ,
                  Cyan        = '0;36' ,  LightCyan  = '1;36' ,
                  LightGray   = '0;37' ,  White      = '1;37' ,
                  NoC         = '0;0'  ,
                )
def c(color):
    return '\033['+ColorDict[color]+'m'


numprint = 12
num      = sys.argv[1] if len(sys.argv) > 1 else None
if isinstance(num,str) and len(num) > 1 and num[0]=='-' and num[1:].isnumeric():
    numprint = int(num[1:])

files = sp.run(['git','ls-files'],text=True,capture_output=True).stdout.split('\n')[0:-1]

file_logs = []

for fn in files:
    log = sp.run(['gitlog','-1','--',fn],text=True,capture_output=True).stdout
    star,sha1,date,time,msg = log.split(' ',4)
    auth = '<'+msg.split(' <')[-1]
    msg  = msg.split(' '+auth)[0]
    filelog = f'{c("Cyan")}{fn:>48s}{c("NoC")} {star} {c("Gold")}{sha1}{c("NoC")} {c("Green")}{date} {time}{c("NoC")} {msg} {c("Blue")}{auth}{c("NoC")}'

    file_logs.append(filelog)

def skey(s):
    div = ' * '
    if div in s:
        ret = s.split(div)[1].split()
        ret = ret[1]+' '+ret[2]
    else:
        ret = s
    return ret

file_logs.sort(key=skey, reverse=True)

numprint = min(numprint,len(file_logs))
for line in file_logs[0:numprint]:
    print(line)
